# Copia este archivo como ".env" (en esta misma carpeta) y rellena tus valores.
# El archivo ".env" NO se sube a Git; este ".env.example" sí.

# Cadena de conexión a PostgreSQL (por ejemplo, la de tu proyecto en Neon)
DATABASE_URL=""

# Texto largo y aleatorio con el que se firman los tokens JWT
JWT_SECRET=""

# API key de Anthropic (console.anthropic.com), usada por el endpoint /chat
ANTHROPIC_API_KEY=""
