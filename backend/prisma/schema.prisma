generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tarea {
  id         Int      @id @default(autoincrement())
  titulo     String
  completada Boolean  @default(false)
  usuarioId  Int
  usuario    Usuario @relation(fields: [usuarioId], references: [id])
}

model Usuario {
  id          Int      @id @default(autoincrement())
  email       String @unique
  password    String 
  tareas      Tarea[]
}